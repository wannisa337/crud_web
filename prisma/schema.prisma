generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model Book {
  id            Int      @id @default(autoincrement())
  title         String
  author        String
  publishedYear Int
  isAvailable   Boolean  @default(true)
  coverImage    String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}